########################################
# Aruba Central Portal - .env.example  #
########################################
# Copy this file to `.env` and fill in values.
# Never commit your real `.env` to GitHub.

# Backend / Aruba Central Auth
ARUBA_BASE_URL=https://apigw-prod2.central.arubanetworks.com
ARUBA_CLIENT_ID=your_client_id_here
ARUBA_CLIENT_SECRET=your_client_secret_here
ARUBA_CUSTOMER_ID=your_customer_id_here
ARUBA_USERNAME=
ARUBA_PASSWORD=
ARUBA_ACCESS_TOKEN=

# Application / Runtime
LOG_LEVEL=INFO
FLASK_ENV=production
PUID=1000
PGID=1000

# Frontend (Vite)
VITE_API_URL=/api
VITE_API_BASE_URL=/api

# Syslog ingest pipeline (LAN devices → this container)
SYSLOG_ENABLED=true
SYSLOG_UDP_PORT=5140           # container port; bind <1024 requires root
SYSLOG_TCP_PORT=5141
SYSLOG_UDP_HOST_PORT=514       # host-side UDP mapping for docker-compose
SYSLOG_TCP_HOST_PORT=1514      # host-side TCP mapping for docker-compose
SYSLOG_RETENTION_DAYS=7
# SYSLOG_DB_PATH=/app/data/syslog.db  # default: <repo>/data/syslog.db
SYSLOG_CLUSTER_ENABLED=true
SYSLOG_CLUSTER_INTERVAL_SEC=30           # how often to run the clusterer
SYSLOG_CLUSTER_WINDOW_SEC=300            # bucket size (same device+code+5min = one incident)
SYSLOG_CLUSTER_LOOKBACK_SEC=1800         # how far back each tick scans
SYSLOG_CLUSTER_BATCH=1000                # cap events per tick

# Testing & Development
DASHBOARD_API_URL=http://localhost:5000/api
TEST_WLAN_PASSWORD=YourSecureTestPassword123!
TEST_GATEWAY_SERIAL=
